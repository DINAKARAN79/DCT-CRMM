# Database
DATABASE_URL="postgresql://postgres:1234@localhost:5432/dct_crm?schema=public"

# Authentication
JWT_SECRET="your-jwt-secret-here"
# Generate with: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=""
JWT_EXPIRES_IN="24h"
APPLICANT_ID_ENCRYPTION_KEY="generate-a-32-byte-base64-key"
# Legacy only: decrypts existing v1 telephony tokens so they can be re-encrypted
# with API_KEY_ENCRYPTION_SECRET when Telephony settings are next saved.
TELEPHONY_CREDENTIALS_KEY="generate-a-32-byte-base64-key"

# CORS
CORS_ORIGIN="http://localhost:3000"

# API
PORT=3001
NODE_ENV=development
# Set the externally reachable API base. Use the origin for direct /api routing,
# or append /api/proxy when the public API is reachable only through Next.js.
# PUBLIC_API_BASE_URL="https://crm.cxteletech.com"
# Comma-separated host allowlist used when PUBLIC_API_BASE_URL is unset.
# ALLOWED_API_HOSTS="crm.cxteletech.com"
# Trust only the Next.js proxy that connects to this API. Use its IP/CIDR if it is remote.
# TRUST_PROXY="loopback"
# The edge proxy in front of Next.js must overwrite and forward:
# Host, X-Forwarded-Host, X-Forwarded-Proto, and X-Forwarded-For.
GOOGLE_MAPS_API_KEY="your-google-maps-geocoding-api-key"

# AI Service
OPENAI_API_KEY="your-openai-api-key"
NODE_API_URL="http://localhost:3001"

# Frontend